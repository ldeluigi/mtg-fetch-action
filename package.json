{
  "name": "mtg-fetch-action",
  "version": "1.5.1",
  "private": true,
  "description": "Fetches MTG Cards from Scryfall and posts previews.",
  "main": "lib/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write ./**/*.ts",
    "format-check": "prettier --check ./**/*.ts",
    "lint": "eslint",
    "package": "ncc build --minify --source-map --license licenses.txt",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldeluigi/mtg-fetch-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "typescript",
    "mtg",
    "github",
    "scryfall"
  ],
  "author": "Luca Deluigi",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "@octokit/webhooks-types": "^7.6.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jaro-winkler": "^0.2.8",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
